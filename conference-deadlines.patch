+++ b/windows/tests/conference_deadlines_tests.cpp
@@ -0,0 +1,113 @@
+#include "modules/conference_deadlines.hpp"
+
+#include <algorithm>
+#include <fstream>
+#include <iostream>
+#include <iterator>
+#include <stdexcept>
+
+using namespace endfield::modules;
+namespace d = design;
+
+namespace {
+void check(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+struct Measurer final : d::TextMeasurer {
+    double width(std::span<const d::TextRun> runs, d::TextRegion) override {
+        double width = 0;
+        for (const auto& run : runs) width += run.text.size() * run.style.size * .5;
+        return width;
+    }
+    d::LineMetrics metrics(const d::TextStyle& style, d::TextRegion, double scale) override {
+        const auto size = style.size * scale;
+        return {size * style.lineHeight, size * .8, size * .2};
+    }
+};
+
+void checkCanvas() {
+    Measurer measurer;
+    d::Context context(measurer, d::asciiUppercase);
+    ConferenceDeadlinesCanvas::Completion pending;
+    int requests{}, sourceVisits{};
+    auto today = CalendarDay{2026, 11, 13};
+    ConferenceDeadlinesCanvas canvas(context, [&](auto complete) { ++requests; pending = std::move(complete); },
+        [&] { return today; }, [&] { ++sourceVisits; }, [] {});
+    const auto rows = [&] {
+        std::vector<d::AccessibilityItem> items;
+        canvas.accessibilityItems(items);
+        std::erase_if(items, [](const auto& item) { return !item.id.starts_with("conferenceDeadlines.row."); });
+        return items;
+    };
+
+    canvas.show(1);
+    canvas.setActive(true, 1);
+    check(requests == 1 && rows().empty(), "Opening should request the feed once");
+    canvas.performAccessibilityAction("conferenceDeadlines.refresh", 1);
+    check(requests == 1, "Refresh should coalesce while loading");
+    std::vector<ConferenceDeadline> sample{{{2026, 11, 12}, "Expired", "", ""}};
+    for (int day = 13; day <= 19; ++day) sample.push_back({{2026, 11, day}, "Conference", "2026", "Full name"});
+    std::exchange(pending, {})(std::move(sample));
+    auto first = rows();
+    check(first.size() == 6 && first.front().label == "Conference 2026" && first.front().value == "2026-11-13",
+        "The first page should include today, exclude past dates and expose deadlines to accessibility");
+    check(canvas.performAccessibilityAction("conferenceDeadlines.next", 2), "Next page should be reachable");
+    auto second = rows();
+    check(second.size() == 1 && second.front().value == "2026-11-19", "The remaining deadline belongs on the next page");
+    check(canvas.performAccessibilityAction("conferenceDeadlines.previous", 3), "Previous page should be reachable");
+    check(rows() == first, "Previous page should restore the first six rows");
+    check(canvas.performAccessibilityAction("conferenceDeadlines.refresh", 4), "Manual refresh should be reachable");
+    check(requests == 2, "Manual refresh should start a new request");
+    std::exchange(pending, {})(std::nullopt);
+    check(rows() == first, "A failed refresh should keep the previous results");
+    check(canvas.performAccessibilityAction("conferenceDeadlines.source", 5) && sourceVisits == 1,
+        "The data source should be reachable");
+    canvas.setActive(false, 6);
+    today = {2026, 11, 14};
+    canvas.setActive(true, 7);
+    check(rows().front().value == "2026-11-14" && requests == 2, "Reopening should use the new local date and cached data");
+}
+}
+
+int main(int argc, char** argv) try {
+    const auto deadlines = decodeConferenceDeadlines(R"([
+        {"name":"Late","year":"2028","deadline":"2028-03-10"},
+        {"name":"Pending","deadline":"TBD"},
+        {"name":"Invalid leap day","deadline":"2026-02-29"},
+        {"name":"Timestamp","deadline":"2028-02-29T12:00:00Z"},
+        {"name":"  First\nConference  ","full_name":"Full name","deadline":"2028-02-29"},
+        {"name":"","full_name":"第二场会议","deadline":"2028-02-29"},
+        {"name":"Missing deadline"},
+        null
+    ])");
+    check(deadlines.size() == 3 && deadlines[0].date == CalendarDay{2028, 2, 29} &&
+        deadlines[0].name == "First Conference" && deadlines[0].fullName == "Full name" &&
+        deadlines[1].name == "第二场会议" && deadlines[2].name == "Late" && deadlines[2].year == "2028",
+        "Conference dates, labels or sort order differ");
+
+    if (!decodeConferenceDeadlines("[]").empty() ||
+        !decodeConferenceDeadlines(R"([{"name":"Pending","deadline":"TBD"}])").empty())
+        throw std::runtime_error("Empty and TBD-only feeds should have no dated rows");
+    for (const auto invalid : {"{}", "not JSON", R"([{"error":"unavailable"}])"}) {
+        try {
+            (void)decodeConferenceDeadlines(invalid);
+        } catch (const std::invalid_argument&) {
+            continue;
+        }
+        throw std::runtime_error("An invalid feed was accepted");
+    }
+    checkCanvas();
+    if (argc > 1) {
+        std::ifstream input(argv[1], std::ios::binary);
+        check(bool(input), "Could not open the downloaded conference feed");
+        const std::string body(std::istreambuf_iterator<char>{input}, {});
+        const auto live = decodeConferenceDeadlines(body);
+        check(!live.empty(), "The downloaded conference feed has no dated entries");
+        std::cout << live.size() << " dated records parsed from the downloaded feed\n";
+    }
+    return 0;
+} catch (const std::exception& error) {
+    std::cerr << error.what() << '\n';
+    return 1;
+}
