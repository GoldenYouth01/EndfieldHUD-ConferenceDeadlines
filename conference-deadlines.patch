+#pragma once
+
+#include "modules/calendar_model.hpp"
+#include "modules/hud_design_page.hpp"
+
+namespace endfield::modules {
+
+inline constexpr std::string_view conferenceFeedURL = "https://call4papers.org/ccf.json";
+inline constexpr std::string_view conferencePageURL = "https://call4papers.org/deadlines";
+inline constexpr std::size_t conferenceFeedMaximumBytes = 8 * 1024 * 1024;
+
+struct ConferenceDeadline {
+    CalendarDay date;
+    std::string name;
+    std::string year;
+    std::string fullName;
+};
+
+// Dates in the feed are civil dates without a time zone or time of day.
+// Unknown and malformed dates are skipped, and equal dates keep feed order.
+std::vector<ConferenceDeadline> decodeConferenceDeadlines(std::string_view);
+
+class ConferenceDeadlinesCanvas final : public design::Canvas {
+public:
+    using Deadlines = std::optional<std::vector<ConferenceDeadline>>;
+    using Completion = std::function<void(Deadlines)>;
+    using Fetch = std::function<void(Completion)>;
+
+    ConferenceDeadlinesCanvas(design::Context&, Fetch, std::function<CalendarDay()> today,
+        std::function<void()> openSource, std::function<void()> changed);
+
+    void buildPage(design::Page&) override;
+    void didActivate() override;
+
+private:
+    void refresh();
+    void finish(Deadlines);
+    void changePage(int step);
+
+    Fetch fetch_;
+    std::function<CalendarDay()> today_;
+    std::function<void()> openSource_, changed_;
+    std::vector<ConferenceDeadline> deadlines_;
+    CalendarDay shownDay_;
+    std::size_t pageIndex_{}, pageCount_{1};
+    bool loading_{}, loaded_{}, failed_{};
+    double refreshAfter_{};
+};
+
+} // namespace endfield::modules
