+#include "modules/conference_deadlines.hpp"
+#include "modules/hud_design_badges.hpp"
+
+#include <algorithm>
+#include <array>
+#include <stdexcept>
+
+namespace endfield::modules {
+namespace d = design;
+namespace {
+constexpr std::size_t pageSize = 6;
+constexpr double rowHeight = 56;
+constexpr double rowPitch = 62;
+
+std::string displayField(const ehud::data::Json& item, std::string_view field, std::size_t limit) {
+    const auto& value = item[field];
+    if (!value.isString()) return {};
+    auto text = value.string();
+    if (text.size() > limit) return {};
+    for (char& c : text)
+        if (static_cast<unsigned char>(c) < 32) c = ' ';
+    const auto first = text.find_first_not_of(' ');
+    if (first == text.npos) return {};
+    return text.substr(first, text.find_last_not_of(' ') - first + 1);
+}
+}
+
+std::vector<ConferenceDeadline> decodeConferenceDeadlines(std::string_view body) {
+    const auto feed = ehud::data::Json::parse(body, conferenceFeedMaximumBytes);
+    if (!feed.isArray()) throw std::invalid_argument("Expected a conference array");
+    std::vector<ConferenceDeadline> deadlines;
+    bool hasDeadlineField = feed.array().empty();
+    for (const auto& item : feed.array()) {
+        if (!item["deadline"].isString()) continue;
+        hasDeadlineField = true;
+        const auto rawDate = displayField(item, "deadline", 10);
+        if (rawDate.size() != 10 || rawDate[4] != '-' || rawDate[7] != '-') continue;
+        const auto date = CalendarDay::parse(rawDate);
+        if (!date || date->string() != rawDate) continue;
+        auto name = displayField(item, "name", 256);
+        auto fullName = displayField(item, "full_name", 1024);
+        if (name.empty()) name = fullName;
+        if (!name.empty()) deadlines.push_back({*date, std::move(name), displayField(item, "year", 12), std::move(fullName)});
+    }
+    if (!hasDeadlineField) throw std::invalid_argument("Conference feed has no deadline fields");
+    std::stable_sort(deadlines.begin(), deadlines.end(), [](const auto& a, const auto& b) { return a.date < b.date; });
+    return deadlines;
+}
+
+ConferenceDeadlinesCanvas::ConferenceDeadlinesCanvas(d::Context& context, Fetch fetch,
+        std::function<CalendarDay()> today, std::function<void()> openSource, std::function<void()> changed)
+    : Canvas(core::Module::conferenceDeadlines, context), fetch_(std::move(fetch)), today_(std::move(today)),
+      openSource_(std::move(openSource)), changed_(std::move(changed)) {}
+
+void ConferenceDeadlinesCanvas::didActivate() {
+    if (!loading_ && now() >= refreshAfter_) refresh();
+    else if (shownDay_ != today_()) rerender();
+}
+
+void ConferenceDeadlinesCanvas::refresh() {
+    if (loading_) return;
+    loading_ = true;
+    failed_ = false;
+    rerender();
+    fetch_([this](Deadlines result) { finish(std::move(result)); });
+}
+
+void ConferenceDeadlinesCanvas::finish(Deadlines result) {
+    catchUpClock();
+    loading_ = false;
+    failed_ = !result;
+    refreshAfter_ = now() + (failed_ ? 60 : 15 * 60);
+    if (result) {
+        deadlines_ = std::move(*result);
+        loaded_ = true;
+        pageIndex_ = 0;
+    }
+    if (isShown()) rerender();
+    else deferRerender();
+    changed_();
+}
+
+void ConferenceDeadlinesCanvas::changePage(int step) {
+    if (step < 0 && pageIndex_ > 0) --pageIndex_;
+    else if (step > 0 && pageIndex_ + 1 < pageCount_) ++pageIndex_;
+    else return;
+    rerender();
+}
+
+void ConferenceDeadlinesCanvas::buildPage(d::Page& page) {
+    shownDay_ = today_();
+    const auto upcoming = std::lower_bound(deadlines_.begin(), deadlines_.end(), shownDay_,
+        [](const auto& entry, CalendarDay day) { return entry.date < day; });
+    const auto count = static_cast<std::size_t>(deadlines_.end() - upcoming);
+    pageCount_ = std::max<std::size_t>(1, (count + pageSize - 1) / pageSize);
+    pageIndex_ = std::min(pageIndex_, pageCount_ - 1);
+
+    auto& refreshButton = page.make<d::Button>("conferenceDeadlines.refresh", text("Refresh", "刷新"),
+        d::Icon::refresh, d::Button::Kind::secondary, d::Button::Height::compact);
+    refreshButton.place({0, 0});
+    refreshButton.setEnabled(!loading_);
+    refreshButton.onActivate = [this] { refresh(); };
+    auto& sourceButton = page.make<d::Button>("conferenceDeadlines.source", "Call4Papers",
+        d::Icon::ext, d::Button::Kind::secondary, d::Button::Height::compact);
+    sourceButton.place({0, 0});
+    sourceButton.onActivate = openSource_;
+    header().configure({text("Conferences", "学术会议")}, "", title("Conference Deadlines", "会议截稿"),
+        std::to_string(count), false, {&refreshButton, &sourceButton});
+
+    if (count == 0) {
+        const auto state = loading_ || (!loaded_ && !failed_) ? text("Loading deadlines", "正在加载截稿日期")
+            : failed_ ? text("Could not load deadlines", "无法加载截稿日期")
+                      : text("No upcoming deadlines", "暂无即将到来的截稿日期");
+        auto& empty = d::emptyState::make(page.builder(), "conferenceDeadlines.empty", state);
+        empty.setOrigin({0, d::metric::headerHeight});
+        page.layer().add(empty);
+        page.stagger(empty);
+        return;
+    }
+
+    const auto offset = pageIndex_ * pageSize;
+    for (std::size_t rowIndex = 0; rowIndex < std::min(pageSize, count - offset); ++rowIndex) {
+        const auto& entry = upcoming[offset + rowIndex];
+        auto name = entry.name;
+        if (!entry.year.empty() && !name.ends_with(entry.year)) name += " " + entry.year;
+        auto subtitle = entry.fullName.empty() || entry.fullName == entry.name ? std::nullopt : std::optional(entry.fullName);
+        auto& row = page.make<d::RowPlate>("conferenceDeadlines.row." + std::to_string(rowIndex), std::move(name),
+            std::move(subtitle), d::RowPlate::Variant::standard,
+            "", d::metric::boxWidth, rowHeight);
+        const auto date = entry.date.string();
+        auto& dateLabel = d::makeText(page.builder(), "conferenceDeadlines.date." + std::to_string(rowIndex), date,
+            d::TextStyle{.size = 15, .weight = d::FontWeight::medium, .color = env().palette.accentInk(), .tabular = true},
+            {0, 0, 108, 18}, d::TextAlignment::right);
+        row.setCluster({&dateLabel});
+        row.readout = date;
+        row.layer().setOrigin({0, d::metric::headerHeight + rowPitch * static_cast<double>(rowIndex)});
+        page.layer().add(row.layer());
+        page.add(row);
+        page.stagger(row.layer());
+    }
+
+    const auto pageNumber = std::to_string(pageIndex_ + 1);
+    const auto totalPages = std::to_string(pageCount_);
+    const std::array<std::string_view, 2> pages{pageNumber, totalPages};
+    auto footer = text("Page {0} of {1}", "第 {0} / {1} 页", pages);
+    if (loading_) footer += "   " + text("Refreshing", "正在刷新");
+    if (failed_) footer += "   " + text("Refresh failed", "刷新失败");
+    auto& status = d::makeText(page.builder(), "conferenceDeadlines.status", footer,
+        d::TextStyle{.size = 13, .color = env().palette.foreground(.75)}, {12, 473, 350, 20});
+    page.layer().add(status);
+
+    const auto addPageButton = [&](std::string id, std::string label, d::Icon icon, double x, bool enabled, int step) {
+        auto& button = page.make<d::Button>(std::move(id), std::move(label), icon,
+            d::Button::Kind::secondary, d::Button::Height::compact);
+        button.place({x, 469}, 104);
+        button.setEnabled(enabled);
+        button.onActivate = [this, step] { changePage(step); };
+        page.layer().add(button.layer());
+        page.add(button);
+    };
+    if (pageCount_ > 1) {
+        addPageButton("conferenceDeadlines.previous", text("Previous", "上一页"), d::Icon::prev, 374, pageIndex_ > 0, -1);
+        addPageButton("conferenceDeadlines.next", text("Next", "下一页"), d::Icon::next, 486, pageIndex_ + 1 < pageCount_, 1);
+    }
+}
+
+} // namespace endfield::modules
