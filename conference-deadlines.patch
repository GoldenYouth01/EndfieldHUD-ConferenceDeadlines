+        transport_.start(std::move(request), [this, complete = std::move(complete)](http::TransportResponse response) {
+            if (response.failure != http::TransportResponse::Failure::none || response.response.status != 200) {
+                complete(std::nullopt);
+                return;
+            }
+            auto result = std::make_shared<ConferenceDeadlinesCanvas::Deadlines>();
+            const auto accepted = executor_.submit(route_,
+                [result, body = std::move(response.response.body)] {
+                    *result = modules::decodeConferenceDeadlines(body);
+                },
+                [result, complete](std::exception_ptr error) {
+                    complete(error ? std::nullopt : std::move(*result));
+                });
+            if (!accepted) complete(std::nullopt);
+        });
+    }
+
+    void drain() { transport_.drain(); }
+    std::optional<double> nextDeadline() const { return transport_.nextDeadline(); }
+    bool deadline(double time) { return transport_.deadline(time); }
+
+private:
+    http::WinHttpTransport::Options transportOptions(const app::ApplicationModuleContext& context, std::uint32_t message) {
+        http::WinHttpTransport::Options options;
+        options.now = context.clock;
+        options.userAgent = L"EndfieldHUD-ConferenceDeadlines";
+        options.notify = [window = static_cast<HWND>(context.window), message] { PostMessageW(window, message, 0, 0); };
+        options.background = [this](auto work, auto done) {
+            return executor_.submit(route_, std::move(work), std::move(done));
+        };
+        return options;
+    }
+
+    app::UtilityExecutor& executor_;
+    app::UtilityExecutor::Route route_;
+    http::WinHttpTransport transport_;
+};
+
+modules::CalendarDay localToday() {
+    SYSTEMTIME local{};
+    GetLocalTime(&local);
+    return {local.wYear, local.wMonth, local.wDay};
+}
+}
+
+std::unique_ptr<app::ModuleOwner> conferenceDeadlinesModule(const app::ApplicationModuleContext& context) {
+    if (!context.host || !context.utility) return {};
+    auto& host = *context.host;
+    auto* design = host.designContext();
+    if (!design) return {};
+
+    app::ModuleRouting routing;
+    routing.pointer = 38;
+    routing.key = 38;
+    routing.message = 38;
+    tools::DesignOwnerOptions options;
+    if (!host.designOwnerOptions(options, "conferenceDeadlines", routing)) return {};
+
+    ConferenceDeadlinesCanvas::Fetch fetch;
+    std::function<modules::CalendarDay()> today;
+    if (context.mode == app::ApplicationAreaMode::production) {
+        const auto message = host.registerMessage();
+        const auto feed = std::make_shared<ConferenceFeed>(context, message);
+        fetch = [feed](auto completion) { feed->fetch(std::move(completion)); };
+        today = localToday;
+        options.message = [feed, message](const auto& input, double) {
+            if (input.message != message) return false;
+            feed->drain();
+            return true;
+        };
+        options.nextWakeTime = [feed](double) { return feed->nextDeadline(); };
+        options.deadline = [feed](double time) { return feed->deadline(time); };
+    } else {
+        today = [] { return modules::CalendarDay{2026, 11, 13}; };
+        fetch = [](auto complete) {
+            complete(modules::decodeConferenceDeadlines(R"([
+                {"name":"HUD 2026","full_name":"Human-centred User Design","deadline":"2026-11-18"},
+                {"name":"DI 2027","full_name":"Desktop Interfaces","deadline":"2026-12-03"}
+            ])"));
+        };
+    }
+
+    auto canvas = std::make_unique<ConferenceDeadlinesCanvas>(*design, std::move(fetch), std::move(today),
+        [&host] { host.openLinkAfterClose(std::string(modules::conferencePageURL)); }, options.changed);
+    auto core = std::make_unique<tools::DesignOwnerCore>(context.rasterizer, *design, std::move(options));
+    core->add(std::move(canvas));
+    return std::make_unique<tools::DesignModuleOwner>(std::move(core));
+}
+
